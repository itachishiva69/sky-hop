# Neon pooled connection string. Copy from your Neon project's Connect dialog.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/skyhop?sslmode=require

# Neon Object Storage S3 credentials. Keep these private.
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.c-1.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_REPLACE_ME
AWS_SECRET_ACCESS_KEY=nsk_live_REPLACE_ME
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=skyhop-assets

# Admin login. Password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECURE=false
